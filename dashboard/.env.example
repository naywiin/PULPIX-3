# =========================
# PULPIX — Frontend (.env)
# =========================

# Opcional: URL del backend si corre en otro origen (ej. http://localhost:8000)
VITE_API_BASE=

# Configuración de tu proyecto Firebase (Console → Project Settings → Web App)
# Habilita los proveedores "Google" y "Email/Password" en Firebase Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
