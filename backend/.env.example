# =========================
# PULPIX — Backend (.env)
# =========================

# Persistencia: "file" para desarrollo local, "firestore" en Cloud Run / producción.
MP_STORE=file
MP_SEED_CLIENTS=false
MP_FIRESTORE_PROJECT=
MP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Autenticación (Firebase Auth: Google + Correo/Contraseña) ---
# En producción mantener en true. En desarrollo sin Firebase puedes usar false.
PULPIX_AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=

# --- URLs públicas para callbacks OAuth ---
PULPIX_PUBLIC_URL=http://localhost:8000
PULPIX_FRONTEND_URL=http://localhost:5173

# --- Cifrado de tokens OAuth en reposo ---
# Genera una clave con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PULPIX_TOKEN_ENCRYPTION_KEY=

# --- Meta Ads OAuth (App de Meta Developers) ---
# Callback autorizado: ${PULPIX_PUBLIC_URL}/api/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0

# --- Google Ads OAuth (Google Cloud OAuth 2.0 + Developer Token) ---
# Callback autorizado: ${PULPIX_PUBLIC_URL}/api/integrations/google-ads/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
