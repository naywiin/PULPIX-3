# Solo NOMBRES de variables. No escribas valores reales en archivos del proyecto:
# defínelas en el entorno del proceso (export, systemd Environment=, secret manager).

# Meta Marketing API (obligatorio para Meta Ads). Token con permiso ads_read.
META_ACCESS_TOKEN=
# Versión de Graph API (opcional)
META_API_VERSION=v24.0

# Google Ads / GA4 usan Application Default Credentials (gcloud auth application-default login).
# Opcional, solo si la cuenta lo requiere:
GOOGLE_ADS_DEVELOPER_TOKEN=

# Opcionales
MP_CACHE_TTL_SECONDS=300
MP_DISCOVERY_TTL_SECONDS=1800
MP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Registro de clientes. Desarrollo local:
MP_STORE=file
# Producción recomendada: MP_STORE=firestore (requiere Firestore +
# roles/datastore.user para la cuenta de servicio de Cloud Run).
MP_FIRESTORE_COLLECTION=clients
# Colección persistente de presupuestos mensuales. Los presupuestos no tienen
# fallback a archivos locales: con MP_STORE=file sus endpoints responden 503.
MP_BUDGETS_FIRESTORE_COLLECTION=performance_budgets
# MP_FIRESTORE_PROJECT=marketing-performance-prod
# MP_FIRESTORE_DATABASE=(default)
# clients.json es el seed inicial, no el almacenamiento mutable de producción.
# MP_CLIENTS_SEED_FILE=/app/backend/data/clients.json
